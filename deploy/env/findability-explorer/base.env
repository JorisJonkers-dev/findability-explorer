# The Process scope: what the app's one Process receives (deploy-kit, spec/v1, chapter 10,
# Configuration). Literals are literal; a derived value is a named placeholder. DEV_USER is never
# set here: the platform's forward-auth provides the identity.

# --- the project's database (internal/platform/pg): where it answers, and the login the edge to
#     platform-postgres derives, which the Secret Store issues and rotates
PGHOST=${dependency:platform-postgres.host}
PGPORT=${dependency:platform-postgres.port}
PGDATABASE=findability-explorer_db
PGSSLMODE=disable
PGUSER=${dependency:platform-postgres.username}
PGPASSWORD=${dependency:platform-postgres.password}

# --- product matching with Claude (internal/analysis/adapters/matcher)
ANTHROPIC_API_KEY=${secret:secret/data/findability-explorer-system/anthropic#api-key}
LLM_MONTHLY_TOKENS=2000000

# --- what one user may start, and how the crawler introduces itself to the sites it reads
ANALYSES_PER_HOUR=10
CRAWLER_CONTACT=admin@jorisjonkers.dev

# --- the Go heap, kept below placement.memory (256Mi)
GOMEMLIMIT=200MiB
