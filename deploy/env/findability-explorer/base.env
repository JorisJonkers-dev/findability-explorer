# The Process scope: what the app's one Process receives (deploy-kit, spec/v1, chapter 10,
# Configuration). Literals are literal; a derived value is a named placeholder. DEV_USER and
# DEV_ROLES are never set here: people sign in with auth-api (docs/adr/0001).

# --- the project's database (internal/platform/pg): where it answers, and the login the edge to
#     platform-postgres derives, which the Secret Store issues and rotates
PGHOST=${dependency:platform-postgres.host}
PGPORT=${dependency:platform-postgres.port}
PGDATABASE=findability-explorer_db
PGSSLMODE=disable
PGUSER=${dependency:platform-postgres.username}
PGPASSWORD=${dependency:platform-postgres.password}

# --- signing in with auth-api (internal/identity): the client registration, and the key that
#     seals the session cookie, the refresh tokens and the API keys admins add (internal/llm)
OIDC_ISSUER=https://auth.jorisjonkers.dev
OIDC_CLIENT_ID=findability-explorer
OIDC_CLIENT_SECRET=${secret:secret/data/findability-explorer-system/oidc#client-secret}
OIDC_REDIRECT_URL=https://digital-strategy.jorisjonkers.dev/auth/callback
SESSION_KEY=${secret:secret/data/findability-explorer-system/session#key}

# --- product matching (internal/llm): the Vault key, the read-only credential vault-anthropic
ANTHROPIC_API_KEY=${secret:secret/data/findability-explorer-system/anthropic#api-key}
LLM_MONTHLY_TOKENS=10000000

# --- how the crawler introduces itself to the sites it reads
CRAWLER_CONTACT=admin@jorisjonkers.dev

# --- the Go heap, kept below placement.memory (256Mi)
GOMEMLIMIT=200MiB
